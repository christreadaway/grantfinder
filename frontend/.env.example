# Copy to .env.local for local development:  cp .env.example .env.local
# On Netlify, set these under Site configuration > Environment variables.

# Signs sign-in sessions and encrypts saved Claude API keys. Required on Netlify
# (at least 32 characters). Locally it is optional: one is generated in .data/.
SECRET_KEY=

# Guest sign-in (no Google needed). Handy locally and for trying a new deploy.
ALLOW_GUEST_LOGIN=true

# Google sign-in. One value serves the button and the server-side check.
# Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Claude model for every AI step (each user brings their own API key).
CLAUDE_MODEL=claude-sonnet-5-5

# On Netlify, AI steps run inside normal requests (about a minute each), which
# works on every plan. Set to true only if your Netlify plan includes background
# functions (current credit-based plans do; legacy Starter does not) to give
# each step up to 15 minutes. Locally, steps run in-process
# (GRANTFINDER_JOB_MODE=direct runs them the Netlify way, for testing).
# GRANTFINDER_BACKGROUND_JOBS=true

# debug = more detail in logs (~/logs/grantfinder/grantfinder.log locally)
LOG_LEVEL=info

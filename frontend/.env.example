# Backend URL. Local: http://localhost:8000
# Netlify: your Railway backend URL, which must start with https://
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth client ID for sign-in (the backend needs the same value as GOOGLE_CLIENT_ID).
# Leave empty to hide the Google button, e.g. when using guest sign-in locally.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

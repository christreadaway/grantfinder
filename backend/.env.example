# GrantFinder AI Backend Configuration
# Copy this file to .env and fill in your values

# Security
SECRET_KEY=your-secret-key-generate-a-random-one

# Google OAuth client ID from Google Cloud Console (ends in .apps.googleusercontent.com).
# Leave empty until Google sign-in is set up; the website needs the same value.
GOOGLE_CLIENT_ID=
# Not used by sign-in today
GOOGLE_CLIENT_SECRET=

# Guest sign-in without Google (off by default). Turn on to try a fresh
# deployment before Google sign-in is set up; turn it off again afterward.
ALLOW_GUEST_LOGIN=false

# Supabase (from Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# AI model (upgradeable without code changes)
CLAUDE_MODEL=claude-sonnet-5

# Logging (info | debug)
LOG_LEVEL=info

# CORS: JSON array; must include your deployed frontend domain
# CORS_ORIGINS=["https://your-site.netlify.app","http://localhost:3000"]
